# Optional. Neon pooled connection string (include sslmode=require).
DATABASE_URL=""
# A direct URL alone also works. Neon pooler URLs are normalized for migrations.
DIRECT_URL=""
# Optional: live companion and step suggestions through OpenRouter.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# Optional alternative provider. An OpenAI key is not needed for OpenRouter.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Required only for the private GET /api/stats endpoint. Use a long random secret.
ANALYTICS_SECRET=""
